# Neon Serverless Postgres 연결 문자열
# Neon 대시보드(https://neon.tech)에서 프로젝트를 생성한 후 제공되는 Connection string을 아래에 입력하세요.
# 예: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# 쉼표로 구분한 실제 서비스 출처. 예: https://example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:4000

# 기존 데이터 관리 및 복구용 비밀값 (충분히 긴 난수 사용)
ADMIN_TOKEN=
MIGRATION_TOKEN=
